{
  "name": "optimistic-oppenheimer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run test:math && vite build && npm run build:widgets && node scripts/generate-sitemap.mjs",
    "build:widgets": "vite build --config vite.widgets.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:math": "node scripts/verify-mortality-consistency.mjs",
    "lighthouse-ci": "node scripts/run-lighthouse-ci.mjs",
    "test:cert": "node scripts/run-instrumented-certification.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile-chrome-pixel --project=mobile-safari-iphone",
    "test:lighthouse": "node scripts/run-lighthouse-ci.mjs",
    "seo:audit": "lighthouse http://127.0.0.1:5173 --only-categories=seo,performance,accessibility,best-practices --output=json --output=html --output-path=./lighthouse/report --chrome-flags=\"--headless=new --no-sandbox --disable-gpu\"",
    "seo:audit:desktop": "lighthouse http://127.0.0.1:5173 --only-categories=seo,performance,accessibility,best-practices --preset=desktop --output=json --output=html --output-path=./lighthouse/report-desktop --chrome-flags=\"--headless=new --no-sandbox --disable-gpu\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "axe-html-reporter": "^2.2.11",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
